        "jsCode": "const preparedRows = $('Prepare Rows').all();\n\nreturn $input.all().filter(item => {\n  const postId = String(item.json.post_id);\n\n  const row = preparedRows.find(\n    p => String(p.json.post_id) === postId\n  );\n\n  return row?.json.postLinkedIn === 'yes';\n});"
      },
