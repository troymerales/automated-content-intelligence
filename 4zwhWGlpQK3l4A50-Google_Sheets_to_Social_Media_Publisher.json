    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  // Only process Ready rows\n  const action = String(row['Action'] ?? '').trim().toLowerCase();\n  if (action !== 'ready') continue;\n\n  // -----------------------------\n  // SCHEDULE\n  // Expected:\n  // 8/12/2026 15:30:00\n  // Manila time (UTC+8)\n  // -----------------------------\n\n  const schedule = String(row['Schedule'] ?? '').trim();\n\n  let scheduledAt = null;\n\n  if (schedule) {\n    const match = schedule.match(\n      /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})\\s+(\\d{1,2}):(\\d{2}):(\\d{2})$/\n    );\n\n    if (!match) {\n      out.push({\n        json: {\n          ...row,\n          'DEBUG Error': 'Schedule format did not match',\n          'DEBUG Schedule Raw': schedule\n        }\n      });\n\n      continue;\n    }\n\n    const [\n      ,\n      month,\n      day,\n      year,\n      hour,\n      minute,\n      second\n    ] = match;\n\n    // Convert Manila time to UTC\n    scheduledAt = Date.UTC(\n      Number(year),\n      Number(month) - 1,\n      Number(day),\n      Number(hour) - 8,\n      Number(minute),\n      Number(second)\n    );\n  }\n\n  // -----------------------------\n  // PLATFORM\n  // -----------------------------\n\n  const platform = String(row['Platform'] ?? '')\n    .trim()\n    .toLowerCase();\n\n  // -----------------------------\n  // EXISTING STATUS\n  // -----------------------------\n\n  const fbStatus = String(row['FB Status'] ?? '')\n    .trim()\n    .toLowerCase();\n\n  const igStatus = String(row['IG Status'] ?? '')\n    .trim()\n    .toLowerCase();\n\n  const liStatus = String(row['LinkedIn Status'] ?? '')\n    .trim()\n    .toLowerCase();\n\n  // -----------------------------\n  // DUE?\n  // -----------------------------\n\n  const due =\n    scheduledAt === null ||\n    scheduledAt <= now;\n\n  // -----------------------------\n  // FINISHED?\n  // -----------------------------\n\n  const fbFinished = fbStatus === 'finished';\n  const igFinished = igStatus === 'finished';\n  const liFinished = liStatus === 'finished';\n\n  // -----------------------------\n  // STATUS\n  //\n  // Future + not finished = pending\n  // Due + not finished    = processing\n  // Finished              = finished\n  // -----------------------------\n\n  let newFbStatus = fbStatus;\n  let newIgStatus = igStatus;\n  let newLiStatus = liStatus;\n\n  if (platform.includes('facebook')) {\n    newFbStatus = fbFinished\n      ? 'finished'\n      : due\n        ? 'processing'\n        : 'pending';\n  }\n\n  if (platform.includes('instagram')) {\n    newIgStatus = igFinished\n      ? 'finished'\n      : due\n        ? 'processing'\n        : 'pending';\n  }\n\n  if (platform.includes('linkedin')) {\n    newLiStatus = liFinished\n      ? 'finished'\n      : due\n        ? 'processing'\n        : 'pending';\n  }\n\n  // -----------------------------\n  // OUTPUT\n  // -----------------------------\n\n  out.push({\n    json: {\n      ...row,\n\n      'FB Status': newFbStatus,\n      'IG Status': newIgStatus,\n      'LinkedIn Status': newLiStatus,\n\n      'Last Status Update': new Date().toISOString(),\n\n      // These tell the workflow whether\n      // each platform should actually post.\n      postFacebook:\n        platform.includes('facebook') &&\n        due &&\n        !fbFinished\n          ? 'yes'\n          : 'no',\n\n      postInstagram:\n        platform.includes('instagram') &&\n        due &&\n        !igFinished\n          ? 'yes'\n          : 'no',\n\n      postLinkedIn:\n        platform.includes('linkedin') &&\n        due &&\n        !liFinished\n          ? 'yes'\n          : 'no',\n\n      // Temporary debugging\n      'DEBUG Due': due,\n      'DEBUG Schedule UTC': scheduledAt !== null\n        ? new Date(scheduledAt).toISOString()\n        : 'none',\n      'DEBUG Now UTC': new Date(now).toISOString()\n    }\n  });\n}\n\nreturn out;\n\n"
      },
