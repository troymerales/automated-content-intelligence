    {
      "parameters": {
        "jsCode": "const grouped = {};\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const postId = String(data.post_id);\n\n  if (!grouped[postId]) {\n    grouped[postId] = {\n      post_id: data.post_id,\n      Platform: data.Platform || '',\n      'FB Status': data['FB Status'] ?? null,\n      'IG Status': data['IG Status'] ?? null,\n      'LinkedIn Status': data['LinkedIn Status'] ?? null,\n      Action: 'Ready',\n      'Last Status Update': data['Last Status Update'] ?? null\n    };\n  }\n\n  if (data.platform === 'Facebook') {\n    grouped[postId]['FB Status'] = data.status;\n  }\n\n  if (data.platform === 'Instagram') {\n    grouped[postId]['IG Status'] = data.status;\n  }\n\n  if (data.platform === 'LinkedIn') {\n    grouped[postId]['LinkedIn Status'] = data.status;\n  }\n\n  const timestamp = data['Last Status Update'];\n\n  if (\n    timestamp &&\n    (\n      !grouped[postId]['Last Status Update'] ||\n      new Date(timestamp) >\n        new Date(grouped[postId]['Last Status Update'])\n    )\n  ) {\n    grouped[postId]['Last Status Update'] = timestamp;\n  }\n}\n\nfor (const post of Object.values(grouped)) {\n  const platform = String(post.Platform).toLowerCase();\n\n  const needsFacebook = platform.includes('facebook');\n  const needsInstagram = platform.includes('instagram');\n  const needsLinkedIn = platform.includes('linkedin');\n\n  const facebookDone =\n    !needsFacebook ||\n    String(post['FB Status']).toLowerCase() === 'finished';\n\n  const instagramDone =\n    !needsInstagram ||\n    String(post['IG Status']).toLowerCase() === 'finished';\n\n  const linkedInDone =\n    !needsLinkedIn ||\n    String(post['LinkedIn Status']).toLowerCase() === 'finished';\n\n  if (facebookDone && instagramDone && linkedInDone) {\n    post.Action = 'Completed';\n  }\n}\n\nreturn Object.values(grouped).map(post => ({\n  json: post\n}));"
      },
